{
  "manifest_version": 3,
  "name": "SMC Trading Assistant",
  "version": "1.0.0",
  "description": "Smart Money Concepts Trading Terminal for TradingView – Local, no external APIs",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://in.tradingview.com/*",
    "https://www.tradingview.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://in.tradingview.com/*",
        "https://www.tradingview.com/*"
      ],
      "js": ["src/content/tradingview-detector.ts"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "SMC Trading Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/overlay.css", "overlay.css"],
      "matches": [
        "https://in.tradingview.com/*",
        "https://www.tradingview.com/*"
      ]
    }
  ]
}
